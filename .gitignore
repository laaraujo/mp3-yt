# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtualenvs (uv creates and manages .venv)
.venv/
venv/
env/

# uv
# uv.lock IS committed -- it pins exact versions for reproducible builds
# and CI. Local caches and the workspace-local installer dir are not.
.uv-install/
.uv-cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# App-local
*.log
.cache/
output/
tmp/

# PyInstaller / packaging artifacts
# Keep build/yt2mp3slicer.spec tracked; ignore everything PyInstaller and the
# build scripts generate inside build/ and dist/.
dist/
build/build/
build/ffmpeg-bin/
build/ffmpeg.zip
build/ffmpeg.tar.xz
build/ffmpeg-extracted/
