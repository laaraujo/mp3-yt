/* mp3-yt-cutter — minimal modern dark theme.
 *
 * Designed to feel current (rounded corners, subtle borders, accent color)
 * while still respecting native Qt widget metrics. Works on Windows, macOS
 * and Linux without needing extra fonts.
 */

* {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", "Cantarell", "Noto Sans", sans-serif;
    font-size: 10pt;
    color: #e6e6e6;
}

QMainWindow, QWidget#centralWidget {
    background-color: #1f2230;
}

QLabel#titleLabel {
    font-size: 18pt;
    font-weight: 600;
    color: #ffffff;
}

QLabel#subtitleLabel {
    color: #9aa0b3;
}

QLabel.fieldLabel {
    color: #b8bccd;
    font-weight: 500;
}

QGroupBox {
    border: 1px solid #2e3346;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px;
    background-color: #262a3a;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #c5c9da;
}

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox {
    background-color: #14172a;
    border: 1px solid #2e3346;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #5b6cff;
    selection-color: white;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #5b6cff;
}

QPushButton {
    background-color: #2e3346;
    border: 1px solid #3a3f55;
    border-radius: 6px;
    padding: 6px 14px;
    color: #e6e6e6;
}

QPushButton:hover {
    background-color: #3a3f55;
}

QPushButton:pressed {
    background-color: #262a3a;
}

QPushButton:disabled {
    color: #6f7491;
    background-color: #262a3a;
}

QPushButton#primaryButton {
    background-color: #5b6cff;
    border: 1px solid #5b6cff;
    color: white;
    font-weight: 600;
    padding: 8px 18px;
}

QPushButton#primaryButton:hover {
    background-color: #6f7eff;
}

QPushButton#primaryButton:disabled {
    background-color: #3a3f6e;
    border: 1px solid #3a3f6e;
    color: #b8bccd;
}

QTabWidget::pane {
    border: 1px solid #2e3346;
    border-radius: 6px;
    background-color: #14172a;
    top: -1px;
}

QTabBar::tab {
    background: #262a3a;
    color: #b8bccd;
    border: 1px solid #2e3346;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 14px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #14172a;
    color: white;
    border-bottom: 1px solid #14172a;
}

QProgressBar {
    background-color: #14172a;
    border: 1px solid #2e3346;
    border-radius: 6px;
    text-align: center;
    color: #e6e6e6;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #5b6cff;
    border-radius: 5px;
}

QListWidget {
    background-color: #14172a;
    border: 1px solid #2e3346;
    border-radius: 6px;
    padding: 4px;
}

QListWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #2e3346;
    color: white;
}

QStatusBar {
    background: #14172a;
    color: #9aa0b3;
}

QToolTip {
    background-color: #14172a;
    color: #e6e6e6;
    border: 1px solid #2e3346;
    padding: 4px;
    border-radius: 4px;
}
